# Copiar este archivo como .env y completar los valores.
# .env esta en .gitignore y NUNCA se commitea.

# Entrega 1 - clave de la API de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de chat de la Entrega 1. Opcional: si no se define, app.py usa gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash


# Entrega 3 - LangSmith (https://smith.langchain.com -> Settings -> API Keys).
# Con LANGSMITH_TRACING=true, cada corrida del pipeline se registra como traza.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-pharmacy-automation
# Solo si la cuenta es de la region EU:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com


# Entrega Final - agente y API (todas opcionales: los valores de abajo son los default)
# Modelo del agente. flash-lite porque cada consulta son 2 o 3 llamadas al LLM.
GEMINI_MODEL_AGENTE=gemini-3.1-flash-lite
# Vueltas agente -> herramientas permitidas por consulta antes de derivar a un humano.
MAX_ITERACIONES=4
# Donde viven la memoria del agente y el ERP simulado.
# DB_MEMORIA=entrega_final/data/memoria_agente.sqlite
# DB_ERP=entrega_final/data/erp_farmacia.sqlite
