# Copiar este archivo como .env y completar los valores.
# .env está en .gitignore y NUNCA se commitea.

# Clave de la API de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo a usar. Opcional: si no se define, el script usa gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
